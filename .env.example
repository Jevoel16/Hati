# Copy the block you need into .env. Placeholder values only; never commit real ones.

# ===== Local =====
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_URL=mysql://root@127.0.0.1:4000/hati
TEST_DATABASE_URL=mysql://root@127.0.0.1:4000/test
JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=

